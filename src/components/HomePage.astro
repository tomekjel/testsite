    <script is:inline>
      (function() {
        function bindTabs() {
          var tabWidgets = document.querySelectorAll('.ms-tabs, .w-tabs');
          tabWidgets.forEach(function(widget) {
            var links = widget.querySelectorAll('.w-tab-link');
            var panes = widget.querySelectorAll('.w-tab-pane');
            links.forEach(function(link) {
              if (link.dataset.tabBound) return;
              link.dataset.tabBound = 'true';
              link.addEventListener('click', function(e) {
                e.preventDefault();
                e.stopPropagation();
                if (e.stopImmediatePropagation) e.stopImmediatePropagation();
                var targetTab = link.getAttribute('data-w-tab');
                if (!targetTab) return;
                links.forEach(function(l) { l.classList.remove('w--current'); });
                link.classList.add('w--current');
                panes.forEach(function(pane) {
                  if (pane.getAttribute('data-w-tab') === targetTab) {
                    pane.classList.add('w--tab-active');
                    pane.style.setProperty('display', 'block', 'important');
                    pane.style.setProperty('opacity', '1', 'important');
                    pane.style.setProperty('visibility', 'visible', 'important');
                    pane.style.setProperty('position', 'relative', 'important');
                  } else {
                    pane.classList.remove('w--tab-active');
                    pane.style.setProperty('display', 'none', 'important');
                    pane.style.setProperty('opacity', '0', 'important');
                    pane.style.setProperty('visibility', 'hidden', 'important');
                    pane.style.setProperty('position', 'absolute', 'important');
                  }
                });
              }, true);
            });
          });
        }
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', bindTabs);
        } else {
          bindTabs();
        }
        document.addEventListener('astro:page-load', bindTabs);
      })();
    </script>
