  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "@id": `https://multi-servis.pl${prefix}/serwis-telewizorow#service`,
      "name": t.seoTitle,
      "description": t.seoDesc,
      "url": `https://multi-servis.pl${prefix}/serwis-telewizorow`,
      "provider": { "@id": "https://multi-servis.pl/#organization" },
      "areaServed": [
        { "@type": "City", "name": "Bydgoszcz" },
        { "@type": "AdministrativeArea", "name": "Wyżyny, Bydgoszcz" },
        { "@type": "AdministrativeArea", "name": "Fordon, Bydgoszcz" },
        { "@type": "AdministrativeArea", "name": "Bartodzieje, Bydgoszcz" },
        { "@type": "AdministrativeArea", "name": "Bielawy, Bydgoszcz" },
        { "@type": "AdministrativeArea", "name": "Szwederowo, Bydgoszcz" },
        { "@type": "AdministrativeArea", "name": "Wzgórze Wolności, Bydgoszcz" },
        { "@type": "AdministrativeArea", "name": "Błonie, Bydgoszcz" },
        { "@type": "AdministrativeArea", "name": "Kapuściska, Bydgoszcz" },
        { "@type": "AdministrativeArea", "name": "Śródmieście, Bydgoszcz" },
        { "@type": "AdministrativeArea", "name": "Osowa Góra, Bydgoszcz" },
        { "@type": "AdministrativeArea", "name": "Solec Kujawski" },
        { "@type": "AdministrativeArea", "name": "Białe Błota" },
        { "@type": "AdministrativeArea", "name": "Osielsko" },
        { "@type": "AdministrativeArea", "name": "Nowa Wieś Wielka" },
        { "@type": "AdministrativeArea", "name": "Województwo kujawsko-pomorskie" }
      ],
      "serviceType": lang === "pl" ? "Naprawa telewizorów" : (lang === "en" ? "TV Repair" : "Ремонт телевізорів"),
      "offers": {
        "@type": "Offer",
        "priceCurrency": "PLN",
        "availability": "https://schema.org/InStock"
      }
    },
    {
      "@type": "FAQPage",
      "@id": `https://multi-servis.pl${prefix}/serwis-telewizorow#faq`,
      "mainEntity": [
        { "@type": "Question", "name": t.faq1Q, "acceptedAnswer": { "@type": "Answer", "text": t.faq1A } },
        { "@type": "Question", "name": t.faq2Q, "acceptedAnswer": { "@type": "Answer", "text": t.faq2A } },
        { "@type": "Question", "name": t.faq3Q, "acceptedAnswer": { "@type": "Answer", "text": t.faq3A } },
        { "@type": "Question", "name": t.faq4Q, "acceptedAnswer": { "@type": "Answer", "text": t.faq4A } }
      ]
    },
    {
      "@type": "HowTo",
      "@id": `https://multi-servis.pl${prefix}/serwis-telewizorow#howto`,
      "name": t.procTitle,
      "step": [
        { "@type": "HowToStep", "position": 1, "name": t.p1Title, "text": t.p1Desc },
        { "@type": "HowToStep", "position": 2, "name": t.p2Title, "text": t.p2Desc },
        { "@type": "HowToStep", "position": 3, "name": t.p3Title, "text": t.p3Desc },
        { "@type": "HowToStep", "position": 4, "name": t.p4Title, "text": t.p4Desc }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": lang === "pl" ? "Strona główna" : (lang === "en" ? "Home" : "Головна"), "item": `https://multi-servis.pl${prefix || "/"}` },
        { "@type": "ListItem", "position": 2, "name": lang === "pl" ? "Serwis Telewizorów" : (lang === "en" ? "TV Repair" : "Ремонт Телевізорів"), "item": `https://multi-servis.pl${prefix}/serwis-telewizorow` }
      ]
    }
  ]
});
---

<Layout
  title={t.seoTitle}
  description={t.seoDesc}
  wfPage="serwis-telewizorow"
  ogImage="/images/service-tv-repair.jpg"
  lang={lang}
  keywords={lang === "pl" ? "serwis telewizorów Bydgoszcz, naprawa TV LED OLED QLED, wymiana podświetlenia, Multi-Servis" : (lang === "en" ? "TV repair Bydgoszcz, LED OLED QLED repair, backlight replacement, Multi-Servis" : "ремонт телевізорів Бидгощ, ремонт LED OLED QLED, заміна підсвічування, Multi-Servis")}
>
  <script slot="head" type="application/ld+json" is:inline set:html={serviceSchema} />

  <!-- Navigation -->
  <Navbar lang={lang} currentPath={currentPath} />

  <!-- Hero Section -->
  <section class="section" style="padding-top: 2rem; padding-bottom: 3.5rem;">
    <div class="container centered">
      <div class="page-header" style="text-align: center; max-width: 860px; margin: 0 auto;">
        <nav aria-label="Breadcrumb" style="margin-bottom: 1rem; font-size: 0.875rem;">
          <ol style="list-style: none; padding: 0; margin: 0; display: inline-flex; align-items: center; gap: 0.5rem;">
            <li><a href={prefix || "/"} style="color: inherit; opacity: 0.75; text-decoration: none;">{lang === "pl" ? "Główna" : (lang === "en" ? "Home" : "Головна")}</a></li>
            <li aria-hidden="true" style="opacity: 0.4; font-size: 0.75rem;">/</li>
            <li aria-current="page" style="color: #d32f2f; font-weight: 600;">{lang === "pl" ? "Serwis Telewizorów" : (lang === "en" ? "TV Repair" : "Ремонт Телевізорів")}</li>
          </ol>
        </nav>
        <div class="section-badge">{t.heroBadge}</div>
        <h1 class="display-h1" style="margin-top: 0.75rem; margin-bottom: 1.25rem;">
          {t.heroTitle}
        </h1>
        <p class="large-paragraph t---neutral-10" style="max-width: 760px; margin: 0 auto 2rem auto;">
          {t.heroSubtitle}
        </p>

        <!-- Trust Mini-Okienka Pills: Centered auto-layout -->
        <div class="hero-quick-stats" style="justify-content: center; margin: 0 auto 2rem auto;">
          {t.pills.map((pill) => (
            <div class="hero-stat-pill">
              {pill}
            </div>
          ))}
        </div>

        <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
          <a href="tel:+48505012914" class="primary-button w-inline-block" style="color: #ffffff !important;">
            <div class="button-content">
              <span class="button-text" style="color: #ffffff !important;">{t.ctaCall}</span>
            </div>
          </a>
          <a href={`${prefix}/kontakt`} class="outline-button w-inline-block">
            <div class="button-content">
              <span class="button-text">{t.ctaContact}</span>
            </div>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Key Parameters Bento Auto-Layout -->
  <section class="section" style="padding: 4.5rem 0;">
    <div class="container centered">
      <div style="text-align: center; max-width: 800px; margin: 0 auto 3rem auto;">
        <div class="section-badge">{t.metricsBadge}</div>
        <h2 class="display-h2" style="margin-top: 0.75rem;">{t.metricsTitle}</h2>
        <p class="large-paragraph t---neutral-10">{t.metricsSubtitle}</p>
      </div>

      <div class="subpage-metrics-grid" style="max-width: 1040px; margin: 0 auto;">
        <div class="subpage-card">
          <div>
            <div class="subpage-metrics-val">{t.m1Val}</div>
            <div class="subpage-metrics-label">{t.m1Label}</div>
          </div>
          <div class="subpage-metrics-desc">{t.m1Desc}</div>
        </div>
        <div class="subpage-card">
          <div>
            <div class="subpage-metrics-val">{t.m2Val}</div>
            <div class="subpage-metrics-label">{t.m2Label}</div>
          </div>
          <div class="subpage-metrics-desc">{t.m2Desc}</div>
        </div>
        <div class="subpage-card">
          <div>
            <div class="subpage-metrics-val">{t.m3Val}</div>
            <div class="subpage-metrics-label">{t.m3Label}</div>
          </div>
          <div class="subpage-metrics-desc">{t.m3Desc}</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Symptoms Section -->
  <section class="section" style="padding: 4.5rem 0;">
    <div class="container centered">
      <div style="text-align: center; max-width: 800px; margin: 0 auto 3rem auto;">
        <div class="section-badge">{t.sympBadge}</div>
        <h2 class="display-h2" style="margin-top: 0.75rem;">{t.sympTitle}</h2>
        <p class="paragraph t---neutral-10">{t.sympSubtitle}</p>
      </div>

      <div class="subpage-grid-3">
        <div class="subpage-card">
          <h3 class="display-h5" style="color: #d32f2f; margin-bottom: 0.5rem;">{t.symp1Title}</h3>
          <p class="paragraph t---neutral-10">{t.symp1Desc}</p>
        </div>
        <div class="subpage-card">
          <h3 class="display-h5" style="color: #d32f2f; margin-bottom: 0.5rem;">{t.symp2Title}</h3>
          <p class="paragraph t---neutral-10">{t.symp2Desc}</p>
        </div>
        <div class="subpage-card">
          <h3 class="display-h5" style="color: #d32f2f; margin-bottom: 0.5rem;">{t.symp3Title}</h3>
          <p class="paragraph t---neutral-10">{t.symp3Desc}</p>
        </div>
        <div class="subpage-card">
          <h3 class="display-h5" style="color: #d32f2f; margin-bottom: 0.5rem;">{t.symp4Title}</h3>
          <p class="paragraph t---neutral-10">{t.symp4Desc}</p>
        </div>
        <div class="subpage-card">
          <h3 class="display-h5" style="color: #d32f2f; margin-bottom: 0.5rem;">{t.symp5Title}</h3>
          <p class="paragraph t---neutral-10">{t.symp5Desc}</p>
        </div>
        <div class="subpage-card">
          <h3 class="display-h5" style="color: #d32f2f; margin-bottom: 0.5rem;">{t.symp6Title}</h3>
          <p class="paragraph t---neutral-10">{t.symp6Desc}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Brands Section -->
  <section class="section" style="padding: 4rem 0;">
    <div class="container centered">
      <div class="section-header" style="text-align: center; max-width: 800px; margin: 0 auto 2.5rem auto;">
        <div class="section-badge">{t.brandsBadge}</div>
        <h2 class="display-h2" style="margin-top: 0.75rem;">{t.brandsTitle}</h2>
        <p class="paragraph t---neutral-10">{t.brandsSubtitle}</p>
      </div>

      <div style="display: flex; flex-wrap: wrap; gap: 0.75rem; justify-content: center;">
        {["Samsung Crystal / QLED / Neo QLED", "LG OLED / NanoCell", "Philips Ambilight", "Sony Bravia", "TCL", "Panasonic", "Hisense", "Xiaomi TV", "Sharp Aquos", "Toshiba", "JVC", "Manta"].map((b) => (
          <div class="brand-pill">
            <span>{b}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Repair Process Section -->
  <section class="section" style="padding: 4.5rem 0;">
    <div class="container centered">
      <div class="section-header" style="text-align: center; max-width: 800px; margin: 0 auto 3rem auto;">
        <div class="section-badge">{t.procBadge}</div>
        <h2 class="display-h2" style="margin-top: 0.75rem;">{t.procTitle}</h2>
      </div>

      <div class="subpage-grid-4">
        <div class="subpage-card">
          <div style="font-size: 1.75rem; font-weight: 800; color: #d32f2f; margin-bottom: 0.5rem; letter-spacing: -0.02em;">01</div>
          <h3 class="display-h5" style="margin-bottom: 0.5rem;">{t.p1Title}</h3>
          <p class="paragraph t---neutral-10">{t.p1Desc}</p>
        </div>
        <div class="subpage-card">
          <div style="font-size: 1.75rem; font-weight: 800; color: #d32f2f; margin-bottom: 0.5rem; letter-spacing: -0.02em;">02</div>
          <h3 class="display-h5" style="margin-bottom: 0.5rem;">{t.p2Title}</h3>
          <p class="paragraph t---neutral-10">{t.p2Desc}</p>
        </div>
        <div class="subpage-card">
          <div style="font-size: 1.75rem; font-weight: 800; color: #d32f2f; margin-bottom: 0.5rem; letter-spacing: -0.02em;">03</div>
          <h3 class="display-h5" style="margin-bottom: 0.5rem;">{t.p3Title}</h3>
          <p class="paragraph t---neutral-10">{t.p3Desc}</p>
        </div>
        <div class="subpage-card">
          <div style="font-size: 1.75rem; font-weight: 800; color: #d32f2f; margin-bottom: 0.5rem; letter-spacing: -0.02em;">04</div>
          <h3 class="display-h5" style="margin-bottom: 0.5rem;">{t.p4Title}</h3>
          <p class="paragraph t---neutral-10">{t.p4Desc}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section: Centered & Structured -->
  <section class="section" style="padding: 4.5rem 0;">
    <div class="container centered">
      <div class="faq-section-header">
        <div class="section-badge">{t.faqBadge}</div>
        <h2 class="display-h2" style="margin-top: 0.5rem;">{t.faqTitle}</h2>
      </div>

      <div class="faq-list-wrap">
        <div class="subpage-card faq-card-item" style="padding: 1.5rem 1.75rem; width: 100%; box-sizing: border-box;">
          <h3 class="display-h5" style="color: #d32f2f; margin-bottom: 0.5rem;">{t.faq1Q}</h3>
          <p class="paragraph t---neutral-10">{t.faq1A}</p>
        </div>
        <div class="subpage-card faq-card-item" style="padding: 1.5rem 1.75rem; width: 100%; box-sizing: border-box;">
          <h3 class="display-h5" style="color: #d32f2f; margin-bottom: 0.5rem;">{t.faq2Q}</h3>
          <p class="paragraph t---neutral-10">{t.faq2A}</p>
        </div>
        <div class="subpage-card faq-card-item" style="padding: 1.5rem 1.75rem; width: 100%; box-sizing: border-box;">
          <h3 class="display-h5" style="color: #d32f2f; margin-bottom: 0.5rem;">{t.faq3Q}</h3>
          <p class="paragraph t---neutral-10">{t.faq3A}</p>
        </div>
        <div class="subpage-card faq-card-item" style="padding: 1.5rem 1.75rem; width: 100%; box-sizing: border-box;">
          <h3 class="display-h5" style="color: #d32f2f; margin-bottom: 0.5rem;">{t.faq4Q}</h3>
          <p class="paragraph t---neutral-10">{t.faq4A}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section: Smoky Glass Card with Abstract Artwork Backdrop -->
  <section class="section inverse" style="padding: 4.5rem 0;">
    <div class="container">
      <div class="cta-glass-card" style="max-width: 860px; margin: 0 auto; padding: clamp(2.25rem, 5vw, 3.5rem) 2rem; text-align: center;">
        <div class="section-badge" style="background: rgba(255,255,255,0.1); color: #ffffff;">{t.ctaBoxBadge}</div>
        <h2 class="display-h2" style="margin-top: 1rem; margin-bottom: 1rem; color: #ffffff;">{t.ctaBoxTitle}</h2>
        <p class="large-paragraph" style="max-width: 600px; margin: 0 auto 2rem auto; color: rgba(255,255,255,0.85);">
          {t.ctaBoxDesc}
        </p>
        <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
          <a href="tel:+48505012914" class="primary-button w-inline-block" style="color: #ffffff !important;">
            <span class="button-text" style="color: #ffffff !important;">{t.ctaBoxBtn1}</span>
          </a>
          <a href={`${prefix}/kontakt`} class="outline-button w-inline-block" style="color: #ffffff; border-color: rgba(255,255,255,0.4);">
            <span class="button-text">{t.ctaBoxBtn2}</span>
          </a>
        </div>
      </div>
    </div>
    <div class="overlay-03"></div>
    <div class="contact-bg"></div>
  </section>

  <!-- Related Services Mesh -->
  <section class="section" style="padding: 4.5rem 0;">
    <div class="container centered">
      <div style="text-align: center; max-width: 800px; margin: 0 auto 2.5rem auto;">
        <div class="section-badge">{t.relBadge}</div>
        <h2 class="display-h3" style="margin-top: 0.5rem;">{t.relTitle}</h2>
        <p class="paragraph t---neutral-10" style="max-width: 600px; margin: 0.5rem auto 0 auto;">{t.relSubtitle}</p>
      </div>

      <div class="subpage-grid-3">
        <a href={`${prefix}/serwis-laptopow`} class="subpage-card" style="text-decoration: none; color: inherit; display: flex; flex-flow: column; justify-content: space-between;">
          <div>
            <div style="font-size: 2rem; margin-bottom: 0.75rem;">💻</div>
            <h3 class="display-h5" style="margin-bottom: 0.5rem;">{lang === "pl" ? "Serwis Laptopów" : (lang === "en" ? "Laptop Repair" : "Ремонт Ноутбуків")}</h3>
            <p class="paragraph t---neutral-10">{lang === "pl" ? "Naprawa płyt głównych, wymiana matryc, czyszczenie chłodzenia." : (lang === "en" ? "Motherboard repairs, screen replacements, cooling service." : "Ремонт материнських плат, заміна матриць, чищення охолодження.")}</p>
          </div>
          <span style="color: #d32f2f; font-weight: 700; margin-top: 1rem; display: inline-block;">{lang === "pl" ? "Szczegóły →" : (lang === "en" ? "Details →" : "Детальніше →")}</span>
        </a>

        <a href={`${prefix}/serwis-komputerow`} class="subpage-card" style="text-decoration: none; color: inherit; display: flex; flex-flow: column; justify-content: space-between;">
          <div>
            <div style="font-size: 2rem; margin-bottom: 0.75rem;">🖥️</div>
            <h3 class="display-h5" style="margin-bottom: 0.5rem;">{lang === "pl" ? "Serwis Komputerów PC" : (lang === "en" ? "PC & Desktop Repair" : "Ремонт Комп’ютерів")}</h3>
            <p class="paragraph t---neutral-10">{lang === "pl" ? "Diagnostyka jednostek stacjonarnych, modernizacje, składanie zestawów." : (lang === "en" ? "Diagnostics of desktop PCs, hardware upgrades, custom builds." : "Діагностика системних блоків, модернізація, збирання ПК.")}</p>
          </div>
          <span style="color: #d32f2f; font-weight: 700; margin-top: 1rem; display: inline-block;">{lang === "pl" ? "Szczegóły →" : (lang === "en" ? "Details →" : "Детальніше →")}</span>
        </a>

        <a href={`${prefix}/cennik`} class="subpage-card" style="text-decoration: none; color: inherit; display: flex; flex-flow: column; justify-content: space-between;">
          <div>
            <div style="font-size: 2rem; margin-bottom: 0.75rem;">🔍</div>
            <h3 class="display-h5" style="margin-bottom: 0.5rem;">{lang === "pl" ? "Cennik i Diagnoza" : (lang === "en" ? "Pricing & Diagnosis" : "Прайс-лист та Діагностика")}</h3>
            <p class="paragraph t---neutral-10">{lang === "pl" ? "Rzetelna diagnoza, indywidualna wycena przed naprawą i gwarancja od 3 do 24 m-cy." : (lang === "en" ? "Thorough diagnosis, individual quote before repair, and 3-24 month warranty." : "Ретельна діагностика, індивідуальна оцінка перед ремонтом та гарантія від 3 до 24 міс.")}</p>
          </div>
          <span style="color: #d32f2f; font-weight: 700; margin-top: 1rem; display: inline-block;">{lang === "pl" ? "Cennik →" : (lang === "en" ? "Pricing →" : "Ціни →")}</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Modern Clean Footer -->
  <Footer lang={lang} />
</Layout>
