        { "@type": "AdministrativeArea", "name": "Osielsko" },
        { "@type": "AdministrativeArea", "name": "Nowa Wieś Wielka" },
        { "@type": "AdministrativeArea", "name": "Województwo kujawsko-pomorskie" }
      ],
      "serviceType": lang === "pl" ? "Naprawa komputerów PC" : (lang === "en" ? "PC & Desktop Repair" : "Ремонт комп'ютерів ПК"),
      "offers": {
        "@type": "Offer",
        "priceCurrency": "PLN",
        "availability": "https://schema.org/InStock"
      }
    },
    {
      "@type": "FAQPage",
      "@id": `https://multi-servis.pl${prefix}/serwis-komputerow#faq`,
      "mainEntity": c.faqs.map((item) => ({
        "@type": "Question",
        "name": item.q,
        "acceptedAnswer": { "@type": "Answer", "text": item.a }
      }))
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": lang === "pl" ? "Strona główna" : (lang === "en" ? "Home" : "Головна"), "item": `https://multi-servis.pl${prefix || "/"}` },
        { "@type": "ListItem", "position": 2, "name": lang === "pl" ? "Serwis Komputerów" : (lang === "en" ? "PC Repair" : "Ремонт ПК"), "item": `https://multi-servis.pl${prefix}/serwis-komputerow` }
      ]
    }
  ]
});
---

<Layout
  title={c.seoTitle}
  description={c.seoDesc}
  wfPage="serwis-komputerow"
  ogImage="/images/service-pc-repair.jpg"
  lang={lang}
  keywords={lang === "pl" ? "serwis komputerów Bydgoszcz, naprawa PC Bydgoszcz, komputer muli, przyspieszanie PC, blue screen, wymiana karty graficznej, modernizacja komputera, Multi-Servis Ku Wiatrakom 18" : (lang === "en" ? "PC repair Bydgoszcz, desktop repair, GPU replacement, PC upgrade, Multi-Servis" : "ремонт комп'ютерів Бидгощ, ремонт ПК, заміна відеокарти, Multi-Servis")}
>
  <script slot="head" type="application/ld+json" is:inline set:html={serviceSchema} />

  <!-- Unified Navbar -->
  <Navbar lang={lang} currentPath={currentPath} />

  <!-- Hero Section -->
  <section class="section" style="padding-top: clamp(95px, 12vh, 120px); padding-bottom: 3.5rem;">
    <div class="container centered">
      <div class="page-header" style="text-align: center; max-width: 860px; margin: 0 auto;">
        <nav aria-label="Breadcrumb" style="margin-bottom: 1rem; font-size: 0.875rem;">
          <ol style="list-style: none; padding: 0; margin: 0; display: inline-flex; align-items: center; gap: 0.5rem;">
            <li><a href={prefix || "/"} style="color: inherit; opacity: 0.75; text-decoration: none;">{lang === "pl" ? "Główna" : (lang === "en" ? "Home" : "Головна")}</a></li>
            <li aria-hidden="true" style="opacity: 0.4; font-size: 0.75rem;">/</li>
            <li aria-current="page" style="color: #d32f2f; font-weight: 600;">{lang === "pl" ? "Serwis Komputerów PC" : (lang === "en" ? "PC Repair" : "Ремонт ПК")}</li>
          </ol>
        </nav>
        <div class="section-badge">{c.heroBadge}</div>
        <h1 class="display-h1" style="margin-top: 0.75rem; margin-bottom: 1.25rem;">
          {c.heroTitle}
        </h1>
        <p class="large-paragraph t---neutral-10" style="max-width: 760px; margin: 0 auto 2rem auto;">
          {c.heroSubtitle}
        </p>

        <!-- Trust Mini-Okienka Pills -->
        <div class="hero-quick-stats" style="justify-content: center; margin: 0 auto 2rem auto;">
          {c.pills.map((pill) => (
            <div class="hero-stat-pill">
              {pill}
            </div>
          ))}
        </div>

        <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
          <a href="tel:+48505012914" class="primary-button w-inline-block" style="color: #ffffff !important;">
            <div class="button-content">
              <span class="button-text" style="color: #ffffff !important;">{c.ctaCall}</span>
            </div>
          </a>
          <a href={`${prefix}/kontakt`} class="outline-button w-inline-block">
            <div class="button-content">
              <span class="button-text">{c.ctaContact}</span>
            </div>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Key Parameters Bento Auto-Layout -->
  <section class="section" style="padding: 4.5rem 0;">
    <div class="container centered">
      <div style="text-align: center; max-width: 800px; margin: 0 auto 3rem auto;">
        <div class="section-badge">{c.metricsBadge}</div>
        <h2 class="display-h2" style="margin-top: 0.75rem;">{c.metricsTitle}</h2>
        <p class="large-paragraph t---neutral-10">{c.metricsSubtitle}</p>
      </div>

      <div class="subpage-metrics-grid" style="max-width: 1040px; margin: 0 auto;">
        <div class="subpage-card">
          <div>
            <div class="subpage-metrics-val">{c.m1Val}</div>
            <div class="subpage-metrics-label">{c.m1Label}</div>
          </div>
          <div class="subpage-metrics-desc">{c.m1Desc}</div>
        </div>
        <div class="subpage-card">
          <div>
            <div class="subpage-metrics-val">{c.m2Val}</div>
            <div class="subpage-metrics-label">{c.m2Label}</div>
          </div>
          <div class="subpage-metrics-desc">{c.m2Desc}</div>
        </div>
        <div class="subpage-card">
          <div>
            <div class="subpage-metrics-val">{c.m3Val}</div>
            <div class="subpage-metrics-label">{c.m3Label}</div>
          </div>
          <div class="subpage-metrics-desc">{c.m3Desc}</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Issues Section -->
  <section class="section" style="padding: 4.5rem 0;">
    <div class="container centered">
      <div style="text-align: center; max-width: 800px; margin: 0 auto 3rem auto;">
        <div class="section-badge">{c.sympBadge}</div>
        <h2 class="display-h2" style="margin-top: 0.75rem;">{c.sympTitle}</h2>
        <p class="large-paragraph t---neutral-10">{c.sympSubtitle}</p>
      </div>

      <div class="subpage-grid-3">
        <div class="subpage-card">
          <h3 class="display-h5" style="color: #d32f2f; margin-bottom: 0.5rem;">{c.symp1Title}</h3>
          <p class="paragraph t---neutral-10">{c.symp1Desc}</p>
        </div>

        <div class="subpage-card">
          <h3 class="display-h5" style="color: #d32f2f; margin-bottom: 0.5rem;">{c.symp2Title}</h3>
          <p class="paragraph t---neutral-10">{c.symp2Desc}</p>
        </div>

        <div class="subpage-card">
          <h3 class="display-h5" style="color: #d32f2f; margin-bottom: 0.5rem;">{c.symp3Title}</h3>
          <p class="paragraph t---neutral-10">{c.symp3Desc}</p>
        </div>

        <div class="subpage-card">
          <h3 class="display-h5" style="color: #d32f2f; margin-bottom: 0.5rem;">{c.symp4Title}</h3>
          <p class="paragraph t---neutral-10">{c.symp4Desc}</p>
        </div>

        <div class="subpage-card">
          <h3 class="display-h5" style="color: #d32f2f; margin-bottom: 0.5rem;">{c.symp5Title}</h3>
          <p class="paragraph t---neutral-10">{c.symp5Desc}</p>
        </div>

        <div class="subpage-card">
          <h3 class="display-h5" style="color: #d32f2f; margin-bottom: 0.5rem;">{c.symp6Title}</h3>
          <p class="paragraph t---neutral-10">{c.symp6Desc}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="section" style="padding: 4.5rem 0;">
    <div class="container centered faq-centered-container" style="max-width: 900px; margin: 0 auto;">
      <div class="section-header faq-section-header" style="text-align: center; max-width: 800px; margin: 0 auto 2.5rem auto; width: 100%;">
        <div class="section-badge" style="margin: 0 auto;">{c.faqBadge}</div>
        <h2 class="display-h2" style="margin-top: 0.75rem; text-align: center;">{c.faqTitle}</h2>
      </div>

      <div class="faq-list-wrap" style="display: flex; flex-flow: column; gap: 1.25rem; width: 100%; max-width: 860px; margin: 0 auto;">
        {c.faqs.map((faq) => (
          <div class="subpage-card faq-card-item" style="padding: 1.5rem 1.75rem; width: 100%; box-sizing: border-box;">
            <h3 class="display-h5" style="margin-bottom: 0.5rem; color: #d32f2f;">{faq.q}</h3>
            <p class="paragraph t---neutral-10" style="margin: 0; line-height: 1.6;">{faq.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Multi-Guard Promo Banner -->
  <section class="section" style="padding: 2rem 0 3.5rem 0;">
    <div class="container">
      <div class="mg-service-promo-card">
        <div class="mg-promo-text-wrap">
          <div class="mg-promo-badge">🛡️ {lang === 'pl' ? 'Autorskie Oprogramowanie Multi-Servis' : (lang === 'en' ? 'Proprietary Multi-Servis Software' : 'Фірмове ПЗ від Multi-Servis')}</div>
          <h3 class="mg-promo-title">
            {lang === 'pl' ? 'Zabezpiecz i monitoruj swój komputer z programem Multi-Guard' : (lang === 'en' ? 'Protect and monitor your PC with Multi-Guard' : 'Захистіть та контролюйте свій ПК з програмою Multi-Guard')}
          </h3>
          <p class="mg-promo-desc">
            {lang === 'pl'
              ? 'Zapytaj w naszym warsztacie o wdrożenie Multi-Guard na Twoim komputerze. Otrzymasz ochronę Microsoft Defender, kontrolę prywatności, stały podgląd obciążenia CPU, RAM i karty graficznej GPU oraz bezpośrednią zdalną pomoc serwisową (w edycji Pro).'
              : (lang === 'en'
                ? 'Ask at our repair workshop about installing Multi-Guard. Benefit from Microsoft Defender management, real-time CPU/RAM/GPU telemetry, privacy controls, and remote support (Pro edition).'
                : 'Запитайте у майстерні про встановлення Multi-Guard на ваш комп’ютер: захист Microsoft Defender, контроль приватності, моніторинг навантаження CPU/RAM/GPU та дистанційна допомога (Pro).')}
          </p>
          <div class="mg-promo-features">
            <span class="mg-promo-feat">⚡ {lang === 'pl' ? 'Monitoring CPU, RAM & GPU na żywo' : (lang === 'en' ? 'Live CPU/RAM/GPU Telemetry' : 'Моніторинг CPU, RAM та GPU')}</span>
            <span class="mg-promo-feat">🛡️ Microsoft Defender</span>
            <span class="mg-promo-feat">🔍 {lang === 'pl' ? 'Wykrywanie Kernel-Power 41 & WHEA' : (lang === 'en' ? 'Kernel-Power 41 & WHEA Logging' : 'Фіксація Kernel-Power 41 та WHEA')}</span>
            <span class="mg-promo-feat">🤝 {lang === 'pl' ? 'Zdalna pomoc techniczna (Pro)' : (lang === 'en' ? 'Remote Support (Pro)' : 'Дистанційна допомога (Pro)')}</span>
          </div>
          <div class="mg-promo-actions">
            <a href={`${prefix}/multi-guard`} class="primary-button w-inline-block" style="color: #ffffff !important; text-decoration: none;">
              <div class="button-content">
                <p class="button-text" style="color: #ffffff !important; margin: 0;">
                  {lang === 'pl' ? 'Poznaj program Multi-Guard →' : (lang === 'en' ? 'Explore Multi-Guard →' : 'Дізнатися більше →')}
                </p>
              </div>
            </a>
            <a href="tel:+48505012914" class="outline-button w-inline-block" style="color: #ffffff; border-color: rgba(255,255,255,0.3); text-decoration: none;">
              <div class="button-content">
                <p class="button-text" style="margin: 0; color: #ffffff;">📞 505 012 914</p>
              </div>
            </a>
          </div>
        </div>

        <div class="mg-promo-visual">
          <div class="mg-promo-window">
            <div class="mg-promo-window-bar">
              <div class="mg-win-title-left">
                <span class="mg-win-icon">🛡️</span>
                <span class="mg-promo-title-bar">{lang === 'pl' ? 'Multi-Guard • Diagnostyka PC & Defender Status' : (lang === 'en' ? 'Multi-Guard • PC Diagnostics & Defender Status' : 'Multi-Guard • Діагностика ПК та статус Defender')}</span>
              </div>
              <div class="mg-win-controls" aria-hidden="true">
                <span class="mg-win-btn" title="Minimalizuj">
                  <svg width="10" height="1" viewBox="0 0 10 1"><rect width="10" height="1" fill="currentColor"/></svg>
                </span>
                <span class="mg-win-btn" title="Maksymalizuj">
                  <svg width="10" height="10" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1"><rect x="0.5" y="0.5" width="9" height="9"/></svg>
                </span>
                <span class="mg-win-btn mg-win-close" title="Zamknij">
                  <svg width="10" height="10" viewBox="0 0 10 10" stroke="currentColor" stroke-width="1.2"><path d="M1 1l8 8M9 1L1 9"/></svg>
                </span>
              </div>
            </div>
            <img
              src="/images/multiguard/multiguard-desktop-ui.png"
              alt="Multi-Guard Panel Diagnostyki i Bezpieczeństwa PC"
              loading="lazy"
              width="1413"
              height="717"
              class="mg-img-fluid"
              style="object-fit: contain; max-width: 100%; height: auto;"
            />
            <div class="mg-promo-caption">
              <span>{lang === 'pl' ? 'Diagnostyka stabilności, SSD i ochrona Microsoft Defender' : (lang === 'en' ? 'Hardware stability, SSD telemetry and Defender security' : 'Діагностика стабільності, SSD та захист Microsoft Defender')}</span>
              <span class="mg-promo-badge" style="font-size: 0.6875rem; padding: 2px 8px; margin: 0 0 0 6px;">Widok poglądowy</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="section inverse" style="padding: 4.5rem 0;">
    <div class="container">
      <div class="cta-glass-card" style="max-width: 860px; margin: 0 auto; padding: clamp(2.25rem, 5vw, 3.5rem) 2rem; text-align: center;">
        <div class="section-badge" style="background: rgba(255,255,255,0.1); color: #ffffff;">{c.ctaBadge}</div>
        <h2 class="display-h2" style="margin-top: 1rem; margin-bottom: 1rem; color: #ffffff;">{c.ctaTitle}</h2>
        <p class="large-paragraph" style="max-width: 600px; margin: 0 auto 2rem auto; color: rgba(255,255,255,0.85);">
          {c.ctaDesc}
        </p>
        <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
          <a href="tel:+48505012914" class="primary-button w-inline-block" style="color: #ffffff !important;">
            <span class="button-text" style="color: #ffffff !important;">{c.ctaCall}</span>
          </a>
          <a href={`${prefix}/kontakt`} class="outline-button w-inline-block" style="color: #ffffff; border-color: rgba(255,255,255,0.4);">
            <span class="button-text">{c.ctaAddressBtn}</span>
          </a>
        </div>
      </div>
    </div>
    <div class="overlay-03"></div>
    <div class="contact-bg"></div>
  </section>

  <!-- Related Services Mesh -->
  <section class="section" style="padding: 4.5rem 0;">
    <div class="container centered">
      <div style="text-align: center; max-width: 800px; margin: 0 auto 2.5rem auto;">
        <div class="section-badge">{c.relBadge}</div>
        <h2 class="display-h3" style="margin-top: 0.5rem;">{c.relTitle}</h2>
        <p class="paragraph t---neutral-10" style="max-width: 600px; margin: 0.5rem auto 0 auto;">{c.relDesc}</p>
      </div>

      <div class="subpage-grid-3">
        <a href={`${prefix}/serwis-laptopow`} class="subpage-card" style="text-decoration: none; color: inherit; display: flex; flex-flow: column; justify-content: space-between;">
          <div>
            <div style="font-size: 2rem; margin-bottom: 0.75rem;">💻</div>
            <h3 class="display-h5" style="margin-bottom: 0.5rem;">{lang === 'pl' ? 'Serwis Laptopów' : lang === 'en' ? 'Laptop Repair' : 'Ремонт ноутбуків'}</h3>
            <p class="paragraph t---neutral-10">
              {lang === 'pl' ? 'Naprawa laptopów po zalaniu, myjka ultradźwiękowa, lutowanie BGA, wymiana matryc, gniazd i układów chłodzenia.' :
               lang === 'en' ? 'Liquid damage restoration, ultrasonic cleaning, BGA soldering, screen and cooling repairs.' :
               'Ремонт після залиття, ультразвукова чистка, BGA-пайка, заміна матриць та систем охолодження.'}
            </p>
          </div>
          <span style="display: inline-flex; align-items: center; gap: 0.25rem; font-weight: 700; color: #d32f2f; margin-top: 1rem;">{c.detailsLink}</span>
        </a>

        <a href={`${prefix}/serwis-telewizorow`} class="subpage-card" style="text-decoration: none; color: inherit; display: flex; flex-flow: column; justify-content: space-between;">
          <div>
            <div style="font-size: 2rem; margin-bottom: 0.75rem;">📺</div>
            <h3 class="display-h5" style="margin-bottom: 0.5rem;">{lang === 'pl' ? 'Serwis Telewizorów' : lang === 'en' ? 'TV Repair' : 'Ремонт телевізорів'}</h3>
            <p class="paragraph t---neutral-10">
              {lang === 'pl' ? 'Wymiana podświetlenia LED, naprawa zasilaczy i płyt głównych TV Samsung, LG, Philips, Sony.' :
               lang === 'en' ? 'LED backlight replacement, power board & logic board repairs for Samsung, LG, Philips, Sony TV.' :
               'Заміна LED-підсвічування, ремонт блоків живлення та материнських плат Samsung, LG, Philips, Sony.'}
            </p>
          </div>
          <span style="display: inline-flex; align-items: center; gap: 0.25rem; font-weight: 700; color: #d32f2f; margin-top: 1rem;">{c.detailsLink}</span>
        </a>

        <a href={`${prefix}/cennik`} class="subpage-card" style="text-decoration: none; color: inherit; display: flex; flex-flow: column; justify-content: space-between;">
          <div>
            <div style="font-size: 2rem; margin-bottom: 0.75rem;">📋</div>
            <h3 class="display-h5" style="margin-bottom: 0.5rem;">{lang === 'pl' ? 'Cennik i Diagnoza' : lang === 'en' ? 'Pricing & Diagnosis' : 'Прайс та діагностика'}</h3>
            <p class="paragraph t---neutral-10">
              {lang === 'pl' ? 'Jasne reguły: rzetelna diagnoza, wycena przed przystąpieniem do naprawy i gwarancja od 3 do 24 m-cy.' :
               lang === 'en' ? 'Clear rules: thorough diagnosis, price quote before repair, and 3-24 month warranty.' :
               'Прозорі умови: точна діагностика, оцінка до початку ремонту та гарантія від 3 до 24 міс.'}
            </p>
          </div>
          <span style="display: inline-flex; align-items: center; gap: 0.25rem; font-weight: 700; color: #d32f2f; margin-top: 1rem;">{c.pricingLink}</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Unified Footer -->
  <Footer lang={lang} />
</Layout>
