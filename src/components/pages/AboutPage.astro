---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../Navbar.astro";
import Footer from "../Footer.astro";
import type { Lang } from "../../i18n/translations";
import "../../styles/ix/index.css";

interface Props {
  lang?: Lang;
}

const { lang = "pl" } = Astro.props;
const prefix = lang === "pl" ? "" : `/${lang}`;
const currentPath = `${prefix}/about`;

const content = {
  pl: {
    seoTitle: "O nas - Multi-Servis | Serwis Elektroniki Bydgoszcz",
    seoDesc: "Poznaj Multi-Servis - ponad 20 lat doświadczenia w naprawie telewizorów, laptopów i elektroniki precyzyjnej w Bydgoszczy (Ku Wiatrakom 18). Tel: 505 012 914.",
    heroBadge: "Ponad 20 lat doświadczenia",
    heroTitle: "O Multi-Servis w Bydgoszczy",
    heroSubtitle: "Profesjonalny serwis elektroniki przy ul. Ku Wiatrakom 18. Ratujemy sprzęt, którego inni nie potrafią naprawić.",
    pills: ["⚡ Szybka realizacja", "😊 Miła i fachowa obsługa", "🔍 Rzetelna diagnoza i wycena", "🛡️ Gwarancja 3-24 m-ce", "🤝 Uczciwa wycena przed naprawą", "🛡️ Autorski Multi-Guard", "📍 Bydgoszcz Wyżyny"],
    missionBadge: "Filozofia pracy",
    missionTitle: "Nasza misja w Multi-Servis",
    missionSubtitle: "Wierzymy w rzetelną naprawę zamiast pochopnego wyrzucania sprzętu. Dzięki zaawansowanej diagnostyce na poziomie komponentów BGA, SMD i mikrolutowania przywracamy do pełnej sprawności telewizory, laptopy i komputery, oszczędzając Twoje pieniądze.",
    m1Val: "20+ lat",
    m1Label: "Doświadczenia w Bydgoszczy",
    m1Desc: "Nieprzerwanie na rynku serwisu elektroniki użytkowej przy ul. Ku Wiatrakom 18. Tysiące pomyślnie zrealizowanych napraw.",
    m2Val: "3-24 m-cy",
    m2Label: "Gwarancja na naprawę",
    m2Desc: "Gwarancja jakości na każdą wykonaną usługę i wymienione nowe komponenty elektroniczne od 3 do 24 miesięcy.",
    m3Val: "Indywidualna",
    m3Label: "Wycena diagnozy",
    m3Desc: "Rzetelne sprawdzenie uszkodzenia w warsztacie, telefon z wyceną robocizny i części przed rozpoczęciem prac.",
    teamBadge: "Doświadczenie & Pasja",
    teamTitle: "Specjalizacja i warsztat",
    teamDesc: "Wieloletnia praktyka w elektronice użytkowej, specjalizacja w diagnozowaniu trudnych usterek płyt głównych, zasilaczy telewizyjnych, matryc LED/OLED oraz mikrolutowania procesorów i układów BGA.",
    softwareBadge: "Innowacje & Oprogramowanie",
    softwareTitle: "Autorskie narzędzie: Multi-Guard dla Windows",
    softwareDesc: "W Multi-Servis nie tylko naprawiamy komponenty elektroniczne, ale również rozwijamy własne dedykowane oprogramowanie ochronne i diagnostyczne dla systemów Windows 10 oraz 11. Multi-Guard w czasie rzeczywistym pilnuje temperatur kluczowych podzespołów, chroni prywatność (blokada nieautoryzowanego dostępu do kamery i mikrofonu), współpracuje z Microsoft Defender oraz pozwala na bezpieczne sesje wsparcia zdalnego wyłącznie za zgodą użytkownika.",
    softwareCta: "Poznaj program Multi-Guard →",
    contactBadge: "Szybki kontakt",
    contactTitle: "Skontaktuj się z nami bezpośrednio",
    contactSubtitle: "Zadzwoń do nas — od ręki przedstawimy wstępną ocenę usterki, kosztorys i dogodny termin naprawy.",
    phoneLabel: "Telefon bezpośredni:",
    ownerLabel: "Serwis:",
    addressLabel: "Adres serwisu:",
    hoursLabel: "Godziny otwarcia:",
    hoursVal: "Pon. - Pt. 10:00 - 17:00",
    noticeBadge: "Kontakt telefoniczny",
    noticeTitle: "Preferujemy kontakt telefoniczny",
    noticeP1: "Otrzymujemy bardzo dużą liczbę ofert handlowych i spamu reklamowego. W związku z powyższym nie odpowiadamy na wiadomości SMS – prosimy o bezpośredni kontakt telefoniczny.",
    callButton: "Zadzwoń: 505 012 914",
    callNote: "Pon. - Pt. 10:00 - 17:00",
    phoneNoticeShort: "W związku z dużą ilością spamu nie odpowiadamy na wiadomości SMS – prosimy o kontakt telefoniczny."
  },
  en: {
    seoTitle: "About Us - Multi-Servis | Electronics Repair Bydgoszcz",
    seoDesc: "About Multi-Servis: over 20 years of experience repairing TVs, laptops, and precision electronics in Bydgoszcz (Ku Wiatrakom 18). Tel: 505 012 914.",
    heroBadge: "Over 20 Years of Experience",
    heroTitle: "About Multi-Servis in Bydgoszcz",
    heroSubtitle: "Professional electronics service shop at Ku Wiatrakom 18. We salvage equipment that other workshops declare unfixable.",
    pills: ["⚡ Fast turnaround", "😊 Friendly & professional service", "🔍 Fault diagnosis & quote", "🛡️ 3-24 months warranty", "🤝 Fair quote before repair", "🛡️ Multi-Guard Software", "📍 Bydgoszcz Wyżyny"],
    missionBadge: "Work Philosophy",
    missionTitle: "Our Mission at Multi-Servis",
    missionSubtitle: "We believe in honest repair instead of prematurely discarding electronics. Through advanced BGA/SMD component-level diagnostics and micro-soldering, we restore TVs, laptops, and PCs to peak condition while saving you money.",
    m1Val: "20+ years",
    m1Label: "Experience in Bydgoszcz",
    m1Desc: "Serving the local community at Ku Wiatrakom 18 for over two decades. Thousands of successfully restored devices.",
    m2Val: "3-24 mos.",
    m2Label: "Repair warranty",
    m2Desc: "Quality guarantee covering every repaired board and newly installed electronic component from 3 to 24 months.",
    m3Val: "Individual",
    m3Label: "Fault diagnosis",
    m3Desc: "Thorough electronic inspection in our workshop, phone call with repair cost before starting work.",
    teamBadge: "Experience & Dedication",
    teamTitle: "Expertise & Workshop",
    teamDesc: "Master electronics technicians specializing in complex motherboard troubleshooting, TV power supplies, LED/OLED matrix drivers, and BGA micro-soldering.",
    softwareBadge: "Innovation & Software",
    softwareTitle: "Proprietary Tool: Multi-Guard for Windows",
    softwareDesc: "At Multi-Servis, we not only repair physical electronic components, but also engineer our own diagnostic and protection software for Windows 10 and 11. Multi-Guard continuously monitors hardware temperatures, protects privacy (blocks unauthorized webcam and microphone access), integrates Microsoft Defender, and enables secure remote assistance sessions strictly upon your authorization.",
    softwareCta: "Explore Multi-Guard →",
    contactBadge: "Direct Contact",
    contactTitle: "Contact Us Directly",
    contactSubtitle: "Call us — we will promptly assess the issue, provide a cost estimate, and schedule a repair.",
    phoneLabel: "Direct Phone:",
    ownerLabel: "Service:",
    addressLabel: "Workshop Address:",
    hoursLabel: "Opening Hours:",
    hoursVal: "Mon. - Fri. 10:00 - 17:00",
    noticeBadge: "Phone Contact",
    noticeTitle: "Phone contact preferred",
    noticeP1: "We receive a large volume of commercial offers and spam daily. In connection with the above, we do not respond to SMS messages – please contact us by phone.",
    callButton: "Call us: +48 505 012 914",
    callNote: "Mon. - Fri. 10:00 - 17:00",
    phoneNoticeShort: "Due to high spam volume, we do not respond to SMS – please call us."
  },
  uk: {
    seoTitle: "Про нас - Multi-Servis | Ремонт електроніки Бидгощ",
    seoDesc: "Дізнайтеся більше про Multi-Servis: понад 20 років досвіду ремонту телевізорів, ноутбуків та складної електроніки у Бидгощі (Ku Wiatrakom 18). Тел: 505 012 914.",
    heroBadge: "Понад 20 років досвіду",
    heroTitle: "Про Multi-Servis у Бидгощі",
    heroSubtitle: "Професійний сервіс електроніки на вул. Ku Wiatrakom 18. Відновлюємо техніку, за яку інші сервіси не беруться.",
    pills: ["⚡ Швидке виконання", "😊 Привітне та професійне обслуговування", "🔍 Діагностика та оцінка несправності", "🛡️ Гарантія 3-24 міс.", "🤝 Чесна оцінка до ремонту", "🛡️ Фірмовий Multi-Guard", "📍 Бидгощ Вижини"],
    missionBadge: "Філософія роботи",
    missionTitle: "Наша місія в Multi-Servis",
    missionSubtitle: "Ми віримо у чесний ремонт замість передчасного викидання техніки. Завдяки компонентній діагностиці BGA/SMD та мікропайці ми повертаємо до життя телевізори, ноутбуки та комп'ютери, заощаджуючи ваші кошти.",
    m1Val: "20+ років",
    m1Label: "Досвіду в Бидгощі",
    m1Desc: "Безперервна робота на ринку ремонту електроніки на вул. Ku Wiatrakom 18. Тисячі успішно відремонтованих пристроїв.",
    m2Val: "3-24 міс.",
    m2Label: "Гарантія на ремонт",
    m2Desc: "Гарантія якості на кожну виконану роботу та замінені електронні компоненти від 3 до 24 місяців.",
    m3Val: "Індивідуальна",
    m3Label: "Діагностика несправності",
    m3Desc: "Точна перевірка пошкоджень у майстерні, дзвінок із вартістю ремонту та деталей до початку робіт.",
    teamBadge: "Досвід та майстерність",
    teamTitle: "Спеціалізація та майстерня",
    teamDesc: "Багаторічний practical досвід у сфері електроніки, діагностика материнських плат, блоків живлення телевізорів, LED/OLED матриць та BGA-пайки.",
    softwareBadge: "Інновації та Програмне Забезпечення",
    softwareTitle: "Власна розробка: Multi-Guard для Windows",
    softwareDesc: "У Multi-Servis ми не лише ремонтуємо електронні компоненти, але й розробляємо власне програмне забезпечення для Windows 10 та 11. Multi-Guard відстежує температури компонентів у реальному часі, захищає приватність (блокування несанкціонованого доступу до камери та мікрофона), взаємодіє з Microsoft Defender і забезпечує безпечну віддалену допомогу виключно за вашої згоди.",
    softwareCta: "Дізнатися більше про Multi-Guard →",
    contactBadge: "Прямий зв'язок",
    contactTitle: "Зв'яжіться з нами напряму",
    contactSubtitle: "Зателефонуйте нам — ми одразу зорієнтуємо щодо несправності, вартості та термінів ремонту.",
    phoneLabel: "Прямий телефон:",
    ownerLabel: "Сервіс:",
    addressLabel: "Адреса майстерні:",
    hoursLabel: "Графік роботи:",
    hoursVal: "Пн. - Пт. 10:00 - 17:00",
    noticeBadge: "Телефонний зв’язок",
    noticeTitle: "Надаємо перевагу дзвінкам",
    noticeP1: "Щодня ми отримуємо велику кількість комерційних пропозицій та спаму. У зв’язку з цим ми не відповідаємо на SMS-повідомлення – просимо звертатися за телефоном.",
    callButton: "Зателефонувати: +48 505 012 914",
    callNote: "Пн. - Пт. 10:00 - 17:00",
    phoneNoticeShort: "У зв’язку зі спамом ми не відповідаємо на SMS – просимо телефонувати."
  }
};

const c = content[lang] || content.pl;

// Organization + BreadcrumbList JSON-LD
const aboutSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "LocalBusiness",
      "@id": "https://multi-servis.pl/#organization",
      "name": "Multi-Servis Bydgoszcz",
      "description": lang === "pl" ? "Serwis z ponad 20-letnim doświadczeniem w diagnozie i naprawie telewizorów, laptopów i komputerów w Bydgoszczy." : "Electronics repair service with 20+ years experience in Bydgoszcz.",
      "telephone": "+48505012914",
      "email": "kontakt@multi-servis.pl",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Ku Wiatrakom 18",
        "addressLocality": "Bydgoszcz",
        "postalCode": "85-856",
        "addressRegion": "Kujawsko-Pomorskie",
        "addressCountry": "PL"
      }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": lang === "pl" ? "Strona główna" : (lang === "en" ? "Home" : "Головна"), "item": `https://multi-servis.pl${prefix || "/"}` },
        { "@type": "ListItem", "position": 2, "name": lang === "pl" ? "O nas" : (lang === "en" ? "About" : "Про нас"), "item": `https://multi-servis.pl${prefix}/about` }
      ]
    }
  ]
});
---

<Layout
  title={c.seoTitle}
  description={c.seoDesc}
  wfPage="about"
  ogImage="/images/social-20preview.avif"
  lang={lang}
  keywords={lang === "pl" ? "Multi-Servis Bydgoszcz, serwis elektroniki, o nas, Ku Wiatrakom 18" : (lang === "en" ? "Multi-Servis Bydgoszcz, electronics repair, about us" : "Multi-Servis Бидгощ, ремонт електроніки, про нас")}
>
  <script slot="head" type="application/ld+json" is:inline set:html={aboutSchema} />

  <!-- Unified Navbar -->
  <Navbar lang={lang} currentPath={currentPath} />

  <!-- Page Header -->
  <section class="section" style="padding-top: 2rem; padding-bottom: 3.5rem;">
    <div class="container centered">
      <div class="page-header" style="text-align: center; max-width: 860px; margin: 0 auto;">
        <nav aria-label="Breadcrumb" style="margin-bottom: 1rem; font-size: 0.875rem;">
          <ol style="list-style: none; padding: 0; margin: 0; display: inline-flex; align-items: center; gap: 0.5rem;">
            <li><a href={prefix || "/"} style="color: inherit; opacity: 0.75; text-decoration: none;">{lang === "pl" ? "Główna" : (lang === "en" ? "Home" : "Головна")}</a></li>
            <li aria-hidden="true" style="opacity: 0.4; font-size: 0.75rem;">/</li>
            <li aria-current="page" style="color: #d32f2f; font-weight: 600;">{lang === "pl" ? "O nas" : (lang === "en" ? "About" : "Про нас")}</li>
          </ol>
        </nav>
        <div class="section-badge">{c.heroBadge}</div>
        <h1 class="display-h1" style="margin-top: 0.75rem; margin-bottom: 1.25rem;">
          {c.heroTitle}
        </h1>
        <div class="page-subheading">
          <div class="large-paragraph t---neutral-10" style="max-width: 740px; margin: 0 auto 2rem auto;">
            {c.heroSubtitle}
          </div>
        </div>

        <!-- Trust Mini-Okienka Pills -->
        <div class="hero-quick-stats" style="justify-content: center; margin: 0 auto 2rem auto;">
          {c.pills.map((pill) => (
            <div class="hero-stat-pill">
              {pill}
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Mission & Experience -->
  <section class="section" style="padding: 4.5rem 0;">
    <div class="container centered">
      <div style="text-align: center; max-width: 800px; margin: 0 auto 3rem auto;">
        <div class="section-badge">{c.missionBadge}</div>
        <h2 class="display-h2" style="margin-top: 0.75rem;">{c.missionTitle}</h2>
        <p class="large-paragraph t---neutral-10">
          {c.missionSubtitle}
        </p>
      </div>

      <div class="subpage-metrics-grid" style="max-width: 1040px; margin: 0 auto;">
        <div class="subpage-card">
          <div>
            <div class="subpage-metrics-val">{c.m1Val}</div>
            <div class="subpage-metrics-label">{c.m1Label}</div>
          </div>
          <div class="subpage-metrics-desc">{c.m1Desc}</div>
        </div>

        <div class="subpage-card">
          <div>
            <div class="subpage-metrics-val">{c.m2Val}</div>
            <div class="subpage-metrics-label">{c.m2Label}</div>
          </div>
          <div class="subpage-metrics-desc">{c.m2Desc}</div>
        </div>

        <div class="subpage-card">
          <div>
            <div class="subpage-metrics-val">{c.m3Val}</div>
            <div class="subpage-metrics-label">{c.m3Label}</div>
          </div>
          <div class="subpage-metrics-desc">{c.m3Desc}</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Specjalizacja i Zespół Section -->
  <section class="section" style="padding: 4.5rem 0;">
    <div class="container centered" style="max-width: 900px; margin: 0 auto; text-align: center;">
      <div style="display: flex; flex-direction: column; align-items: center; text-align: center;">
        <div class="section-badge" style="margin: 0 auto;">{c.teamBadge}</div>
        <h2 class="display-h2" style="margin-top: 0.75rem; text-align: center;">{c.teamTitle}</h2>
        <div class="large-paragraph t---neutral-10" style="margin-top: 1rem; margin-bottom: 2rem; max-width: 780px; text-align: center;">
          {c.teamDesc}
        </div>
        <div class="team-card subpage-card" style="display: inline-flex; align-items: center; gap: 1.25rem; padding: 1rem 1.75rem; margin: 0 auto;">
          <div style="width: 56px; height: 56px; border-radius: 50%; background: #d32f2f; color: #fff; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; font-weight: 700; flex-shrink: 0;">
            MS
          </div>
          <div style="text-align: left;">
            <div class="display-h5" style="margin-bottom: 0;">Multi-Servis Bydgoszcz</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Autorskie Oprogramowanie Multi-Guard -->
  <section class="section" style="padding: 2rem 0 4.5rem 0;">
    <div class="container centered" style="max-width: 1040px; margin: 0 auto;">
      <div class="mg-service-promo-card">
        <div class="mg-promo-info">
          <div class="mg-promo-badge">🛡️ {c.softwareBadge}</div>
          <h2 class="mg-promo-title">{c.softwareTitle}</h2>
          <p class="mg-promo-desc">{c.softwareDesc}</p>
          <div class="mg-promo-actions">
            <a href={`${prefix}/multi-guard`} class="primary-button w-inline-block" style="color: #ffffff !important; text-decoration: none;">
              <div class="button-content">
                <p class="button-text" style="color: #ffffff !important; margin: 0;">{c.softwareCta}</p>
              </div>
            </a>
            <a href="tel:+48505012914" class="outline-button w-inline-block" style="text-decoration: none;">
              <div class="button-content">
                <p class="button-text" style="margin: 0;">📞 505 012 914</p>
              </div>
            </a>
          </div>
        </div>

        <div class="mg-promo-window">
          <div class="mg-promo-window-bar">
            <div class="mg-win-title-left">
              <span class="mg-win-icon">🛡️</span>
              <span class="mg-promo-title-bar">{lang === 'pl' ? 'Multi-Guard Pro • Autorskie Oprogramowanie Windows' : (lang === 'en' ? 'Multi-Guard Pro • Proprietary Windows Software' : 'Multi-Guard Pro • Фірмове програмне забезпечення')}</span>
            </div>
            <div class="mg-win-controls" aria-hidden="true">
              <span class="mg-win-btn" title="Minimalizuj">
                <svg width="10" height="1" viewBox="0 0 10 1"><rect width="10" height="1" fill="currentColor"/></svg>
              </span>
              <span class="mg-win-btn" title="Maksymalizuj">
                <svg width="10" height="10" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1"><rect x="0.5" y="0.5" width="9" height="9"/></svg>
              </span>
              <span class="mg-win-btn mg-win-close" title="Zamknij">
                <svg width="10" height="10" viewBox="0 0 10 10" stroke="currentColor" stroke-width="1.2"><path d="M1 1l8 8M9 1L1 9"/></svg>
              </span>
            </div>
          </div>
          <img
            src="/images/multiguard/multiguard-pro-desktop.png"
            alt="Multi-Guard Pro Oprogramowanie Multi-Servis"
            loading="lazy"
            width="1360"
            height="880"
            class="mg-img-fluid"
            style="display: block; width: 100%; height: auto; object-fit: contain;"
          />
          <div class="mg-promo-caption">
            <span>{lang === 'pl' ? 'Autorskie oprogramowanie ochronne i diagnostyczne Multi-Servis' : (lang === 'en' ? 'Proprietary diagnostic & security software by Multi-Servis' : 'Фірмове діагностичне та захисне ПЗ від Multi-Servis')}</span>
            <span class="mg-promo-badge" style="font-size: 0.6875rem; padding: 2px 8px;">Widok poglądowy</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact Section -->
  <section id="contact" class="section inverse" style="padding: 5rem 0;">
    <div class="container">
      <div class="contact-section-wrap" style="max-width: 1040px; margin: 0 auto;">
        <div class="contact-header" style="text-align: center; margin-bottom: 3rem;">
          <div class="section-badge" style="background: rgba(255,255,255,0.1); color: #ffffff;">{c.contactBadge}</div>
          <h2 class="display-h2" style="margin-top: 0.75rem; color: #ffffff;">{c.contactTitle}</h2>
          <div class="large-paragraph" style="color: rgba(255, 255, 255, 0.85); margin-top: 0.5rem;">
            {c.contactSubtitle}
          </div>
        </div>

        <div class="contact-grid-body">
          <div class="contact-phone-preference-wrap" style="width: 100%;">
            <div class="contact-info-card" style="height: 100%; box-sizing: border-box; justify-content: space-between;">
              <div>
                <div class="contact-card-header">
                  <div class="section-badge" style="margin-bottom: 0.5rem; background: rgba(211, 47, 47, 0.25); color: #ff8a80; border: 1px solid rgba(255, 82, 82, 0.3);">{c.noticeBadge}</div>
                  <h3 class="display-h4" style="margin: 0; color: #ffffff;">{c.noticeTitle}</h3>
                </div>

                <div style="margin-top: 1.25rem; font-size: 0.95rem; line-height: 1.6; color: rgba(255, 255, 255, 0.88);">
                  <p style="margin: 0;">
                    {c.noticeP1}
                  </p>
                </div>
              </div>

              <div style="padding-top: 1.25rem; border-top: 1px solid rgba(255, 255, 255, 0.12); text-align: center; margin-top: 1.5rem;">
