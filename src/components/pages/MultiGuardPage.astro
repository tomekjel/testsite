// Structured Data for Multi-Guard (SoftwareApplication + Breadcrumbs + FAQPage)
const multiGuardSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "@id": `https://multi-servis.pl${prefix}/multi-guard#software`,
      "name": "Multi-Guard",
      "applicationCategory": "SecurityApplication",
      "operatingSystem": "Windows 10, Windows 11",
      "author": {
        "@type": "LocalBusiness",
        "@id": "https://multi-servis.pl/#organization",
        "name": "Multi-Servis",
        "telephone": "+48505012914",
        "url": "https://multi-servis.pl"
      },
      "description": c.seoDesc,
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "PLN",
        "availability": "https://schema.org/InStoreOnly",
        "description": lang === "pl" ? "Dostępne i wdrażane w serwisie Multi-Servis w Bydgoszczy" : "Available at Multi-Servis workshop in Bydgoszcz"
      },
      "featureList": [
        "Microsoft Defender Integration",
        "Windows Firewall Management",
        "Browser Shield Anti-Scam Protection",
        "Webcam & Microphone Privacy Controls",
        "Real-Time CPU, RAM & GPU Hardware Telemetry",
        "Early Fault Detection (Kernel-Power 41 & WHEA)",
        "On-Demand User-Consented Remote Support (Pro)",
        "Component Test Center (In Development)"
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": c.breadcrumbHome,
          "item": `https://multi-servis.pl${prefix || "/"}`
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": c.breadcrumbCurrent,
          "item": `https://multi-servis.pl${prefix}/multi-guard`
        }
      ]
    },
    {
      "@type": "FAQPage",
      "@id": `https://multi-servis.pl${prefix}/multi-guard#faq`,
      "mainEntity": c.faqs.map(faq => ({
        "@type": "Question",
        "name": faq.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": faq.a
        }
      }))
    }
  ]
});
