const c = content[lang] || content.pl;
---

<Layout
  title={c.seoTitle}
  description={c.seoDesc}
  wfPage="case-studies"
  ogImage="/images/social-20preview.avif"
  lang={lang}
>
  <!-- Unified Navbar -->
  <Navbar lang={lang} currentPath={currentPath} />

  <!-- Page Header -->
  <section class="section" style="padding-top: 2rem; padding-bottom: 3.5rem;">
    <div class="container centered">
      <div class="page-header" style="text-align: center; max-width: 860px; margin: 0 auto;">
        <div class="section-badge">{c.heroBadge}</div>
        <h1 class="display-h1" style="margin-top: 0.75rem; margin-bottom: 1.25rem;">
          {c.heroTitle}
        </h1>
        <div class="page-subheading">
          <div class="large-paragraph t---neutral-10" style="max-width: 740px; margin: 0 auto 2rem auto;">
            {c.heroSubtitle}
          </div>
        </div>

        <!-- Trust Mini-Okienka Pills -->
        <div class="hero-quick-stats" style="justify-content: center; margin: 0 auto 2rem auto;">
          {c.pills.map((pill) => (
            <div class="hero-stat-pill">
              {pill}
            </div>
          ))}
        </div>
      </div>

      <!-- Case Study Grid -->
      <div class="case-study-cms-wrap w-dyn-list" style="margin-top: 2.5rem;">
        <div role="list" class="case-study-cms-list w-dyn-items" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr)); gap: 2rem;">
          {c.items.map((item) => (
            <div role="listitem" class="case-study-cms w-dyn-item subpage-card" style="padding: 1.5rem; display: flex; flex-direction: column;">
              <div class="case-study w-inline-block">
                <div class="thumbnail-wrap" style="position: relative; overflow: hidden; border-radius: 12px; margin-bottom: 1rem;">
                  <div class="year" style="position: absolute; top: 10px; left: 10px; background: rgba(0,0,0,0.7); backdrop-filter: blur(8px); padding: 4px 10px; border-radius: 6px; z-index: 2;">
                    <div class="small-paragraph" style="color: #ffffff; font-weight: 600; font-size: 0.8rem;">{item.tag}</div>
                  </div>
                  <img src={item.img} loading="lazy" alt={item.title} class="thumbnail" style="width: 100%; height: 220px; object-fit: cover; border-radius: 8px;" />
                </div>
                <div class="case-study-text">
                  <h3 class="display-h5" style="margin-bottom: 0.5rem; font-size: 1.15rem;">{item.title}</h3>
                  <div class="paragraph t---neutral-10" style="line-height: 1.5;">{item.desc}</div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Contact Section -->
  <section id="contact" class="section inverse" style="padding: 5rem 0;">
    <div class="container">
      <div class="contact-section-wrap" style="max-width: 860px; margin: 0 auto;">
        <div class="contact-header" style="text-align: center; margin-bottom: 2.5rem;">
          <div class="section-badge" style="background: rgba(255,255,255,0.1); color: #ffffff;">{c.ctaBadge}</div>
          <h2 class="display-h2" style="margin-top: 0.75rem; color: #ffffff;">{c.ctaTitle}</h2>
          <div class="large-paragraph" style="color: rgba(255, 255, 255, 0.85); margin-top: 0.5rem;">
            {c.ctaSubtitle}
          </div>
        </div>

        <div class="contact-info-wrap" style="width: 100%;">
          <div class="contact-info-card">
            <div class="large-paragraph" style="color: rgba(255, 255, 255, 0.9);">
              <strong style="color: #ffffff;">{c.phoneLabel} </strong> 
              <a href="tel:+48505012914" style="color: #ffffff; text-decoration: underline; font-weight: 700;">505 012 914</a>
            </div>
            <div class="large-paragraph" style="color: rgba(255, 255, 255, 0.9);">
              <strong style="color: #ffffff;">{c.ownerLabel} </strong> Multi-Servis
            </div>
            <div class="large-paragraph" style="color: rgba(255, 255, 255, 0.9);">
              <strong style="color: #ffffff;">{c.addressLabel} </strong> Ku Wiatrakom 18, 85-856 Bydgoszcz (Wyżyny)
            </div>
            <div class="large-paragraph" style="color: rgba(255, 255, 255, 0.9);">
              <strong style="color: #ffffff;">{c.hoursLabel} </strong> {c.hoursVal}
            </div>
            <div class="display-h5" style="margin-top: 0.5rem; color: #ffffff;">
              <a href="mailto:kontakt@multi-servis.pl" style="color: #ffffff; text-decoration: none;">kontakt@multi-servis.pl</a>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="overlay-03"></div>
    <div class="contact-bg"></div>
  </section>

  <!-- Modern Clean Footer -->
  <Footer lang={lang} />
</Layout>
